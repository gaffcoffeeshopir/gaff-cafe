# 🇮🇷 برای دسترسی بدون فیلترشکن در ایران:
# سایت را روی Liara هم deploy کن (liara.json آماده است)
# بعد PUBLIC_BASE_URL را آدرس Liara بگذار، مثلاً:
# PUBLIC_BASE_URL=https://gaff-cafe.liara.run
# Render را هم نگه دار — با VPN برای خارج کار می‌کند

# ⚠️ برای ماندگاری دائمی منو روی Render (الزامی):
# 1) در neon.tech یک Postgres رایگان بساز
# 2) Connection string را کپی کن
# 3) در Render → Environment → DATABASE_URL را ست کن
# DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require

# فقط برای لوکال اگر پروکسی داری:
# HTTPS_PROXY=http://127.0.0.1:10809
